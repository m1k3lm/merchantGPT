# Copy to release.env (gitignored) and fill in; every cargo build
# compiles these into the app so merchants only sign in with Google.
# Google Cloud OAuth client of type "Desktop app", Google Ads API enabled:
MERCHANTGPT_GOOGLE_OAUTH_CLIENT_ID=
MERCHANTGPT_GOOGLE_OAUTH_CLIENT_SECRET=
# Developer token from the API Center of the publisher's Google Ads manager account:
MERCHANTGPT_GOOGLE_ADS_DEVELOPER_TOKEN=
